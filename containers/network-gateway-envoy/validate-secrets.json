{
  "static_resources": {
    "listeners": [
      {
        "address": {
          "pipe": {
            "mode": 384,
            "path": "/run/envoy/inject.sock"
          }
        },
        "filter_chains": [
          {
            "filters": [
              {
                "name": "envoy.filters.network.http_connection_manager",
                "typed_config": {
                  "@type": "type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager",
                  "codec_type": "HTTP1",
                  "common_http_protocol_options": {
                    "headers_with_underscores_action": "REJECT_REQUEST"
                  },
                  "generate_request_id": false,
                  "http_filters": [
                    {
                      "name": "envoy.filters.http.wasm",
                      "typed_config": {
                        "@type": "type.googleapis.com/envoy.extensions.filters.http.wasm.v3.Wasm",
                        "config": {
                          "allow_on_headers_stop_iteration": true,
                          "configuration": {
                            "@type": "type.googleapis.com/google.protobuf.StringValue",
                            "value": "{\"mode\": \"inject\"}"
                          },
                          "name": "surf-scoter-secrets",
                          "vm_config": {
                            "code": {
                              "local": {
                                "filename": "/usr/local/lib/surf-scoter/secrets_filter.wasm"
                              }
                            },
                            "runtime": "envoy.wasm.runtime.v8",
                            "vm_id": "surf-scoter-secrets"
                          }
                        }
                      }
                    },
                    {
                      "name": "envoy.filters.http.router",
                      "typed_config": {
                        "@type": "type.googleapis.com/envoy.extensions.filters.http.router.v3.Router",
                        "suppress_envoy_headers": true
                      }
                    }
                  ],
                  "max_request_headers_kb": 16,
                  "request_headers_timeout": "10s",
                  "route_config": {
                    "name": "inject",
                    "virtual_hosts": [
                      {
                        "domains": [
                          "*"
                        ],
                        "name": "inject",
                        "routes": [
                          {
                            "direct_response": {
                              "status": 404
                            },
                            "match": {
                              "prefix": "/"
                            },
                            "name": "inject"
                          }
                        ]
                      }
                    ]
                  },
                  "stat_prefix": "inject",
                  "stream_idle_timeout": "900s"
                }
              }
            ]
          }
        ],
        "name": "inject"
      }
    ]
  }
}
