+/// Whether the forward proxy fills placeholders in plain `http://` requests.
+///
+/// Through `CONNECT` the proxy re-originates TLS to the upstream, so an injected
+/// secret is only ever sent encrypted. An absolute-form `http://` request is
+/// forwarded as plain HTTP, so a secret injected into it crosses the network in
+/// the clear. `Allow` keeps the historical behaviour; `Refuse` answers any
+/// placeholder in such a request with `403` before anything is sent.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]
+pub enum PlaintextInjection {
+    #[default]
+    Allow,
+    Refuse,
+}
