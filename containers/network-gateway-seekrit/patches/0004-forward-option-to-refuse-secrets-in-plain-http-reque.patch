@@ -0,0 +1,274 @@
+//! `[forward] plaintext_injection = "refuse"`: secrets are only injected over TLS.
+//!
+//! Proves:
+//!   1. a placeholder in a plain `http://` request to a ruled host — in a header,
+//!      the path, or the body — is refused with 403 and never forwarded;
+//!   2. the same host still gets its secret through `CONNECT`, where the proxy
+//!      re-originates TLS;
+//!   3. a plain request without a placeholder is forwarded as before;
+//!   4. the default (`allow`) keeps the historical behaviour, and an unknown
+//!      value is a config error.
+
+use std::convert::Infallible;
+use std::net::SocketAddr;
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::sync::{Arc, Mutex};
+
+use arc_swap::ArcSwap;
+use bytes::Bytes;
+use http_body_util::{BodyExt, Full};
+use hyper::body::Incoming;
+use hyper::server::conn::http1;
+use hyper::service::service_fn;
+use hyper::{Request, Response};
+use hyper_util::rt::TokioIo;
+use rustls::pki_types::{CertificateDer, PrivateKeyDer, PrivatePkcs8KeyDer};
+use seekrit_proxy::ca::Ca;
+use seekrit_proxy::config::{Config, PlaintextInjection};
+use seekrit_proxy::forward::{self, ForwardState};
+use seekrit_proxy::secrets::SecretStore;
+use seekrit_proxy::tasks::SessionResolver;
+use tokio::net::TcpListener;
+use tokio_rustls::TlsAcceptor;
+
+/// What the upstream received: a hit count and the last `authorization` header.
+#[derive(Clone, Default)]
+struct Seen {
+    hits: Arc<AtomicUsize>,
+    authorization: Arc<Mutex<Option<String>>>,
+}
+
+impl Seen {
+    fn hits(&self) -> usize {
+        self.hits.load(Ordering::SeqCst)
+    }
+    fn authorization(&self) -> String {
+        self.authorization
+            .lock()
+            .unwrap()
+            .clone()
+            .unwrap_or_default()
+    }
+}
+
+async fn record(req: Request<Incoming>, seen: Seen) -> Result<Response<Full<Bytes>>, Infallible> {
+    seen.hits.fetch_add(1, Ordering::SeqCst);
+    *seen.authorization.lock().unwrap() = req
+        .headers()
+        .get("authorization")
+        .and_then(|v| v.to_str().ok())
+        .map(str::to_string);
+    let _ = req.into_body().collect().await;
+    Ok(Response::new(Full::new(Bytes::from_static(b"ok"))))
+}
+
+async fn http_upstream(seen: Seen) -> SocketAddr {
+    let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let addr = listener.local_addr().unwrap();
+    tokio::spawn(async move {
+        while let Ok((tcp, _)) = listener.accept().await {
+            let seen = seen.clone();
+            tokio::spawn(async move {
+                let svc = service_fn(move |req| record(req, seen.clone()));
+                let _ = http1::Builder::new()
+                    .serve_connection(TokioIo::new(tcp), svc)
+                    .await;
+            });
+        }
+    });
+    addr
+}
+
+async fn tls_upstream(host: &str, seen: Seen) -> (SocketAddr, String) {
+    let key = rcgen::KeyPair::generate().unwrap();
+    let cert = rcgen::CertificateParams::new(vec![host.to_string()])
+        .unwrap()
+        .self_signed(&key)
+        .unwrap();
+    let pem = cert.pem();
+    let der: CertificateDer<'static> = cert.der().clone();
+    let key_der = PrivateKeyDer::Pkcs8(PrivatePkcs8KeyDer::from(key.serialize_der()));
+    let server = rustls::ServerConfig::builder_with_provider(Arc::new(
+        rustls::crypto::ring::default_provider(),
+    ))
+    .with_safe_default_protocol_versions()
+    .unwrap()
+    .with_no_client_auth()
+    .with_single_cert(vec![der], key_der)
+    .unwrap();
+    let acceptor = TlsAcceptor::from(Arc::new(server));
+    let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let addr = listener.local_addr().unwrap();
+    tokio::spawn(async move {
+        while let Ok((tcp, _)) = listener.accept().await {
+            let acceptor = acceptor.clone();
+            let seen = seen.clone();
+            tokio::spawn(async move {
+                if let Ok(tls) = acceptor.accept(tcp).await {
+                    let svc = service_fn(move |req| record(req, seen.clone()));
+                    let _ = http1::Builder::new()
+                        .serve_connection(TokioIo::new(tls), svc)
+                        .await;
+                }
+            });
+        }
+    });
+    (addr, pem)
+}
+
+fn temp_ca() -> (Ca, String) {
+    static SEQ: AtomicUsize = AtomicUsize::new(0);
+    let dir = std::env::temp_dir().join(format!(
+        "seekrit-proxy-plaintext-{}-{}",
+        std::process::id(),
+        SEQ.fetch_add(1, Ordering::SeqCst)
+    ));
+    std::fs::create_dir_all(&dir).unwrap();
+    let ca = Ca::load_or_generate(
+        dir.join("ca.pem").to_str().unwrap(),
+        dir.join("ca-key.pem").to_str().unwrap(),
+    )
+    .unwrap();
+    let pem = ca.cert_pem().to_string();
+    (ca, pem)
+}
+
+/// A forward proxy for `cfg`. Its own client resolves `api.test` to `upstream`
+/// and trusts `upstream_pem`, so the fake host works for both planes.
+async fn forward_proxy(
+    cfg: &str,
+    upstream: SocketAddr,
+    upstream_pem: Option<&str>,
+) -> (String, String) {
+    let config = Config::from_toml(cfg).unwrap();
+    let mut client = reqwest::Client::builder().resolve("api.test", upstream);
+    if let Some(pem) = upstream_pem {
+        client =
+            client.add_root_certificate(reqwest::Certificate::from_pem(pem.as_bytes()).unwrap());
+    }
+    let (ca, ca_pem) = temp_ca();
+    let state = ForwardState {
+        egress: Arc::new(seekrit_proxy::egress::Egress::from_config(&config)),
+        client: client.build().unwrap(),
+        config: Arc::new(config),
+        store: Arc::new(ArcSwap::from_pointee(SecretStore::from_values([(
+            "API_KEY".to_string(),
+            "s3cr3t-value".to_string(),
+        )]))),
+        ca: Arc::new(ca),
+        metrics: Arc::new(seekrit_proxy::telemetry::Metrics::new()),
+        policy: None,
+        sessions: Arc::new(SessionResolver::new(None, None)),
+        ratchet: None,
+        activity: None,
+        approvals: None,
+    };
+    let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let addr = listener.local_addr().unwrap();
+    tokio::spawn(
+        async move { forward::serve(listener, state, std::future::pending::<()>()).await },
+    );
+    (format!("http://{addr}"), ca_pem)
+}
+
+fn agent(proxy: &str, ca_pem: &str) -> reqwest::Client {
+    reqwest::Client::builder()
+        .proxy(reqwest::Proxy::http(proxy).unwrap())
+        .proxy(reqwest::Proxy::https(proxy).unwrap())
+        .add_root_certificate(reqwest::Certificate::from_pem(ca_pem.as_bytes()).unwrap())
+        .build()
+        .unwrap()
+}
+
+const REFUSE: &str = "[forward]\nlisten='127.0.0.1:0'\nplaintext_injection='refuse'\n\
+                      [[forward.host]]\nmatch='api.test'\nallow=['API_KEY']\n";
+
+#[tokio::test]
+async fn a_placeholder_anywhere_in_a_plain_request_is_refused() {
+    let seen = Seen::default();
+    let upstream = http_upstream(seen.clone()).await;
+    let (proxy, ca) = forward_proxy(REFUSE, upstream, None).await;
+    let agent = agent(&proxy, &ca);
+
+    let header = agent
+        .get("http://api.test/x")
+        .header("authorization", "Bearer {{seekrit:API_KEY}}");
+    let path = agent.get("http://api.test/x?key={{seekrit:API_KEY}}");
+    let body = agent
+        .post("http://api.test/x")
+        .body("k={{seekrit:API_KEY}}");
+    for (where_, request) in [("header", header), ("path", path), ("body", body)] {
+        let resp = request.send().await.unwrap();
+        assert_eq!(resp.status(), 403, "{where_}");
+        assert!(
+            resp.text()
+                .await
+                .unwrap()
+                .contains("only injected over TLS"),
+            "{where_}"
+        );
+    }
+    assert_eq!(seen.hits(), 0, "nothing was forwarded");
+
+    // Without a placeholder, plain HTTP to the same host is forwarded.
+    let resp = agent.get("http://api.test/x").send().await.unwrap();
+    assert_eq!(resp.status(), 200);
+    assert_eq!(seen.hits(), 1);
+}
+
+#[tokio::test]
+async fn the_same_host_still_gets_its_secret_over_tls() {
+    let seen = Seen::default();
+    let (upstream, pem) = tls_upstream("api.test", seen.clone()).await;
+    let (proxy, ca) = forward_proxy(REFUSE, upstream, Some(&pem)).await;
+
+    let resp = agent(&proxy, &ca)
+        .get(format!("https://api.test:{}/x", upstream.port()))
+        .header("authorization", "Bearer {{seekrit:API_KEY}}")
+        .send()
+        .await
+        .unwrap();
+    assert_eq!(resp.status(), 200);
+    assert_eq!(seen.authorization(), "Bearer s3cr3t-value");
+}
+
+#[tokio::test]
+async fn the_default_still_injects_over_plain_http() {
+    let seen = Seen::default();
+    let upstream = http_upstream(seen.clone()).await;
+    let (proxy, ca) = forward_proxy(
+        "[forward]\nlisten='127.0.0.1:0'\n[[forward.host]]\nmatch='api.test'\nallow=['API_KEY']\n",
+        upstream,
+        None,
+    )
+    .await;
+    let resp = agent(&proxy, &ca)
+        .get("http://api.test/x")
+        .header("authorization", "Bearer {{seekrit:API_KEY}}")
+        .send()
+        .await
+        .unwrap();
+    assert_eq!(resp.status(), 200);
+    assert_eq!(seen.authorization(), "Bearer s3cr3t-value");
+}
+
+#[test]
+fn the_config_parses_plaintext_injection() {
+    let parse = |v: &str| {
+        Config::from_toml(&format!("[forward]\n{v}"))
+            .map(|c| c.forward.unwrap().plaintext_injection)
+            .map_err(|e| e.to_string())
+    };
+    assert_eq!(parse(""), Ok(PlaintextInjection::Allow));
+    assert_eq!(
+        parse("plaintext_injection='allow'"),
+        Ok(PlaintextInjection::Allow)
+    );
+    assert_eq!(
+        parse("plaintext_injection='Refuse'"),
+        Ok(PlaintextInjection::Refuse)
+    );
+    assert!(parse("plaintext_injection='never'")
+        .unwrap_err()
+        .contains("\"allow\" or \"refuse\""));
+}
