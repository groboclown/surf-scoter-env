+/// The first well-formed placeholder in `input`, if there is one — by exactly
+/// the rules [`substitute`] uses, so the two can never disagree about what a
+/// placeholder is.
+pub fn find_placeholder(input: &[u8]) -> Option<String> {
+    match substitute(input, &|_: &str| Lookup::Denied) {
+        Err(SubError::Denied(name)) => Some(name),
+        _ => None,
+    }
+}
