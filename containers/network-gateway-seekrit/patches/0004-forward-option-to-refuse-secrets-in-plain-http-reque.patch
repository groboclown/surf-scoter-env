+/// The first placeholder anywhere a plain request would carry it: the path and
+/// query, any header value, or the body — the same three places
+/// [`inject_and_forward`] substitutes.
+fn plaintext_placeholder(path_and_query: &str, headers: &HeaderMap, body: &[u8]) -> Option<String> {
+    find_placeholder(path_and_query.as_bytes())
+        .or_else(|| {
+            headers
+                .values()
+                .find_map(|v| find_placeholder(v.as_bytes()))
+        })
+        .or_else(|| find_placeholder(body))
+}
