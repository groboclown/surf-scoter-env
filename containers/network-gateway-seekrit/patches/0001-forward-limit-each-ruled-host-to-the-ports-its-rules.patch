diff --git a/tests/ports.rs b/tests/ports.rs
new file mode 100644
index 0000000..81f023c
--- /dev/null
+++ b/tests/ports.rs
@@ -0,0 +1,333 @@
+//! Per-host `ports` on `[[forward.host]]`.
+//!
+//! Proves:
+//!   1. `CONNECT` to a ruled host is refused on a port its rules do not give, and
+//!      intercepted on one they do;
+//!   2. the same for plain `http://` (default port 80 when none is written);
+//!   3. a ruled host on another port is refused even under
+//!      `unmatched_host_policy = "tunnel"` — tunnelling it would step around the
+//!      host's rules;
+//!   4. a rule without `ports` still allows any port;
+//!   5. the config refuses empty lists, non-ports, and rules for one host that
+//!      disagree.
+
+use std::convert::Infallible;
+use std::net::SocketAddr;
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::sync::Arc;
+
+use arc_swap::ArcSwap;
+use axum::routing::any;
+use axum::Router;
+use bytes::Bytes;
+use http_body_util::Full;
+use hyper::body::Incoming;
+use hyper::server::conn::http1;
+use hyper::service::service_fn;
+use hyper::{Request, Response};
+use hyper_util::rt::TokioIo;
+use rustls::pki_types::{CertificateDer, PrivateKeyDer, PrivatePkcs8KeyDer};
+use seekrit_proxy::ca::Ca;
+use seekrit_proxy::config::Config;
+use seekrit_proxy::egress::Egress;
+use seekrit_proxy::forward::{self, ForwardState};
+use seekrit_proxy::secrets::SecretStore;
+use seekrit_proxy::tasks::SessionResolver;
+use tokio::net::TcpListener;
+use tokio_rustls::TlsAcceptor;
+
+fn temp_ca() -> Ca {
+    static SEQ: AtomicUsize = AtomicUsize::new(0);
+    let dir = std::env::temp_dir().join(format!(
+        "seekrit-proxy-ports-{}-{}",
+        std::process::id(),
+        SEQ.fetch_add(1, Ordering::SeqCst)
+    ));
+    std::fs::create_dir_all(&dir).unwrap();
+    Ca::load_or_generate(
+        dir.join("ca.pem").to_str().unwrap(),
+        dir.join("ca-key.pem").to_str().unwrap(),
+    )
+    .unwrap()
+}
+
+/// A TLS upstream for `localhost`, counting hits. Returns its address and cert.
+async fn tls_upstream(hits: Arc<AtomicUsize>) -> (SocketAddr, String) {
+    let key = rcgen::KeyPair::generate().unwrap();
+    let cert = rcgen::CertificateParams::new(vec!["localhost".to_string()])
+        .unwrap()
+        .self_signed(&key)
+        .unwrap();
+    let pem = cert.pem();
+    let der: CertificateDer<'static> = cert.der().clone();
+    let key_der = PrivateKeyDer::Pkcs8(PrivatePkcs8KeyDer::from(key.serialize_der()));
+    let server = rustls::ServerConfig::builder_with_provider(Arc::new(
+        rustls::crypto::ring::default_provider(),
+    ))
+    .with_safe_default_protocol_versions()
+    .unwrap()
+    .with_no_client_auth()
+    .with_single_cert(vec![der], key_der)
+    .unwrap();
+    let acceptor = TlsAcceptor::from(Arc::new(server));
+
+    let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let addr = listener.local_addr().unwrap();
+    tokio::spawn(async move {
+        while let Ok((tcp, _)) = listener.accept().await {
+            let acceptor = acceptor.clone();
+            let hits = hits.clone();
+            tokio::spawn(async move {
+                if let Ok(tls) = acceptor.accept(tcp).await {
+                    let svc = service_fn(move |_req: Request<Incoming>| {
+                        hits.fetch_add(1, Ordering::SeqCst);
+                        async {
+                            Ok::<_, Infallible>(Response::new(Full::new(Bytes::from_static(b"ok"))))
+                        }
+                    });
+                    let _ = http1::Builder::new()
+                        .serve_connection(TokioIo::new(tls), svc)
+                        .await;
+                }
+            });
+        }
+    });
+    (addr, pem)
+}
+
+/// A plain HTTP upstream, counting hits.
+async fn http_upstream(hits: Arc<AtomicUsize>) -> SocketAddr {
+    let app = Router::new().fallback(any(move || {
+        let hits = hits.clone();
+        async move {
+            hits.fetch_add(1, Ordering::SeqCst);
+            "ok"
+        }
+    }));
+    let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let addr = listener.local_addr().unwrap();
+    tokio::spawn(async move {
+        axum::serve(listener, app).await.unwrap();
+    });
+    addr
+}
+
+/// A forward proxy for `cfg`, wired as `main.rs` wires it. Returns its URL and
+/// its CA. With `upstream_pem`, the proxy's own client trusts that certificate
+/// too, so it can re-originate TLS to a self-signed test upstream.
+async fn forward_proxy(cfg: &str, upstream_pem: Option<&str>) -> (String, String) {
+    let config = Config::from_toml(cfg).unwrap();
+    let egress = Arc::new(Egress::from_config(&config));
+    let client = match upstream_pem {
+        Some(pem) => reqwest::Client::builder()
+            .add_root_certificate(reqwest::Certificate::from_pem(pem.as_bytes()).unwrap())
+            .build()
+            .unwrap(),
+        None => seekrit_proxy::upstream_client(egress.clone()).unwrap(),
+    };
+    let ca = temp_ca();
+    let ca_pem = ca.cert_pem().to_string();
+    let state = ForwardState {
+        client,
+        egress,
+        config: Arc::new(config),
+        store: Arc::new(ArcSwap::from_pointee(SecretStore::from_values([]))),
+        ca: Arc::new(ca),
+        metrics: Arc::new(seekrit_proxy::telemetry::Metrics::new()),
+        policy: None,
+        sessions: Arc::new(SessionResolver::new(None, None)),
+        ratchet: None,
+        activity: None,
+        approvals: None,
+    };
+    let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let addr = listener.local_addr().unwrap();
+    tokio::spawn(
+        async move { forward::serve(listener, state, std::future::pending::<()>()).await },
+    );
+    (format!("http://{addr}"), ca_pem)
+}
+
+/// An agent that proxies through `proxy`, trusting `pem` (the proxy's CA, when
+/// the proxy intercepts) if given.
+fn agent(proxy: &str, pem: Option<&str>) -> reqwest::Client {
+    let mut b = reqwest::Client::builder()
+        .proxy(reqwest::Proxy::http(proxy).unwrap())
+        .proxy(reqwest::Proxy::https(proxy).unwrap());
+    if let Some(pem) = pem {
+        b = b.add_root_certificate(reqwest::Certificate::from_pem(pem.as_bytes()).unwrap());
+    }
+    b.build().unwrap()
+}
+
+/// The upstreams live on loopback; open that range to the egress gate.
+fn base(unmatched: &str) -> String {
+    format!(
+        "[egress]\nallow_cidr=['127.0.0.0/8']\n\
+         [forward]\nlisten='127.0.0.1:0'\nunmatched_host_policy='{unmatched}'\n"
+    )
+}
+
+#[tokio::test]
+async fn connect_follows_the_ports_an_intercepting_rule_gives() {
+    let hits = Arc::new(AtomicUsize::new(0));
+    let (upstream, pem) = tls_upstream(hits.clone()).await;
+    let url = format!("https://localhost:{}/x", upstream.port());
+
+    let (wrong, ca) = forward_proxy(
+        &format!(
+            "{}[[forward.host]]\nmatch='localhost'\nports=[443]\n",
+            base("deny")
+        ),
+        Some(&pem),
+    )
+    .await;
+    assert!(agent(&wrong, Some(&ca)).get(&url).send().await.is_err());
+    assert_eq!(hits.load(Ordering::SeqCst), 0, "never intercepted");
+
+    let (right, ca) = forward_proxy(
+        &format!(
+            "{}[[forward.host]]\nmatch='localhost'\nports=[443, {}]\n",
+            base("deny"),
+            upstream.port()
+        ),
+        Some(&pem),
+    )
+    .await;
+    let resp = agent(&right, Some(&ca)).get(&url).send().await.unwrap();
+    assert_eq!(resp.status(), 200);
+    assert_eq!(hits.load(Ordering::SeqCst), 1);
+}
+
+#[tokio::test]
+async fn plain_http_follows_the_ports_an_intercepting_rule_gives() {
+    let hits = Arc::new(AtomicUsize::new(0));
+    let upstream = http_upstream(hits.clone()).await;
+    let url = format!("http://localhost:{}/x", upstream.port());
+
+    let (wrong, _) = forward_proxy(
+        &format!(
+            "{}[[forward.host]]\nmatch='localhost'\nports=[80]\n",
+            base("deny")
+        ),
+        None,
+    )
+    .await;
+    let resp = agent(&wrong, None).get(&url).send().await.unwrap();
+    assert_eq!(resp.status(), 403);
+    let body = resp.text().await.unwrap();
+    assert!(
+        body.contains(&format!("not allowed on port {}", upstream.port())) && body.contains("80"),
+        "{body}"
+    );
+    assert_eq!(hits.load(Ordering::SeqCst), 0);
+
+    let (right, _) = forward_proxy(
+        &format!(
+            "{}[[forward.host]]\nmatch='localhost'\nports=[{}]\n",
+            base("deny"),
+            upstream.port()
+        ),
+        None,
+    )
+    .await;
+    let resp = agent(&right, None).get(&url).send().await.unwrap();
+    assert_eq!(resp.status(), 200);
+    assert_eq!(hits.load(Ordering::SeqCst), 1);
+}
+
+#[tokio::test]
+async fn a_ruled_host_on_another_port_is_not_tunnelled_as_unmatched() {
+    let hits = Arc::new(AtomicUsize::new(0));
+    let (upstream, pem) = tls_upstream(hits.clone()).await;
+    // Unmatched hosts are tunnelled here, but `localhost` is not unmatched: its
+    // rule says port 443, so another port is refused rather than tunnelled
+    // around the rule's methods.
+    let (proxy, _) = forward_proxy(
+        &format!(
+            "{}[[forward.host]]\nmatch='localhost'\nmethods=['GET']\nports=[443]\n",
+            base("tunnel")
+        ),
+        None,
+    )
+    .await;
+    let result = agent(&proxy, Some(&pem))
+        .post(format!("https://localhost:{}/x", upstream.port()))
+        .send()
+        .await;
+    assert!(result.is_err());
+    assert_eq!(hits.load(Ordering::SeqCst), 0);
+}
+
+#[tokio::test]
+async fn a_rule_without_ports_allows_any_port() {
+    let hits = Arc::new(AtomicUsize::new(0));
+    let upstream = http_upstream(hits.clone()).await;
+    let (proxy, _) = forward_proxy(
+        &format!("{}[[forward.host]]\nmatch='localhost'\n", base("deny")),
+        None,
+    )
+    .await;
+    let resp = agent(&proxy, None)
+        .get(format!("http://localhost:{}/x", upstream.port()))
+        .send()
+        .await
+        .unwrap();
+    assert_eq!(resp.status(), 200);
+    assert_eq!(hits.load(Ordering::SeqCst), 1);
+}
+
+#[test]
+fn the_config_records_ports_per_host() {
+    let config = Config::from_toml(
+        "[forward]\n\
+         [[forward.host]]\nmatch='api.test'\nmethods=['GET']\nports=[443, 8443]\n\
+         [[forward.host]]\nmatch='api.test'\nmethods=['POST']\nports=[8443, 443]\n\
+         [[forward.host]]\nmatch='any.test'\n",
+    )
+    .unwrap();
+    let fwd = config.forward.unwrap();
+    assert!(fwd.permits_port("api.test", 443) && fwd.permits_port("API.test", 8443));
+    assert!(!fwd.permits_port("api.test", 80));
+    assert!(fwd.permits_port("any.test", 80) && fwd.permits_port("any.test", 1));
+}
+
+#[test]
+fn the_config_refuses_bad_ports() {
+    for (rules, expect) in [
+        (
+            "[[forward.host]]\nmatch='a.test'\nports=[]\n",
+            "empty `ports`",
+        ),
+        (
+            "[[forward.host]]\nmatch='a.test'\nports=[0]\n",
+            "not a TCP port",
+        ),
+        (
+            "[[forward.host]]\nmatch='a.test'\nports=[65536]\n",
+            "not a TCP port",
+        ),
+        (
+            "[[forward.host]]\nmatch='a.test'\nports=[-1]\n",
+            "not a TCP port",
+        ),
+        (
+            "[[forward.host]]\nmatch='a.test'\nports=[443]\n\
+             [[forward.host]]\nmatch='a.test'\nmethods=['GET']\n",
+            "different ports",
+        ),
+        (
+            "[[forward.host]]\nmatch='a.test'\nports=[443]\n\
+             [[forward.host]]\nmatch='a.test'\nports=[8443]\n",
+            "different ports",
+        ),
+    ] {
+        let err = Config::from_toml(&format!("[forward]\n{rules}"))
+            .err()
+            .map(|e| e.to_string());
+        assert!(
+            err.as_deref().is_some_and(|e| e.contains(expect)),
+            "expected {expect:?} for:\n{rules}\ngot {err:?}"
+        );
+    }
+}
