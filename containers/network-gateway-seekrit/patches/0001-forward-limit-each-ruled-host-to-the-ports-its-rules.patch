+/// The refusal for a ruled host on a port its rules do not give, if it is one.
+///
+/// Only hosts with a rule in this file are limited; an unruled host is left to
+/// `unmatched_host_policy`, and server policy carries no ports.
+fn refuse_port(state: &ForwardState, host: &str, port: u16) -> Option<Response<Body>> {
+    let fwd = state.fwd();
+    let ruled = fwd.rules.as_ref().is_some_and(|r| r.covers_host(host));
+    if !ruled || fwd.permits_port(host, port) {
+        return None;
+    }
+    let allowed = fwd
+        .ports_of(host)
+        .map(|ports| {
+            ports
+                .iter()
+                .map(u16::to_string)
+                .collect::<Vec<_>>()
+                .join(", ")
+        })
+        .unwrap_or_default();
+    warn!(reason = "port_not_allowed", %host, port, "denied: port not allowed for this host");
+    state
+        .metrics
+        .record_request(PLANE_FORWARD, "port_not_allowed");
+    Some(text(
+        StatusCode::FORBIDDEN,
+        &format!("host {host:?} is not allowed on port {port}; its rules allow {allowed}"),
+    ))
+}
