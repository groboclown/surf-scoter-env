+/// Validate a host rule's `ports`: absent means any; present must be a non-empty
+/// list of real TCP ports.
+fn validate_ports(
+    host: &str,
+    ports: Option<Vec<i64>>,
+) -> Result<Option<BTreeSet<u16>>, ConfigError> {
+    let Some(ports) = ports else {
+        return Ok(None);
+    };
+    if ports.is_empty() {
+        // An empty list reads like "no ports", which would make the rule
+        // useless; leave `ports` out to mean "any".
+        return Err(ConfigError::Forward(format!(
+            "host {host:?} has an empty `ports` list; to allow any port, leave it out"
+        )));
+    }
+    ports
+        .into_iter()
+        .map(|p| {
+            u16::try_from(p).ok().filter(|p| *p != 0).ok_or_else(|| {
+                ConfigError::Forward(format!("host {host:?}: {p} is not a TCP port (1-65535)"))
+            })
+        })
+        .collect::<Result<BTreeSet<u16>, _>>()
+        .map(Some)
+}
