index 0000000..49f5aed
--- /dev/null
+++ b/tests/tunnel.rs
@@ -0,0 +1,312 @@
+//! Tunnel-only host rules (`[[forward.host]] intercept = false`).
+//!
+//! Proves:
+//!   1. under `unmatched_host_policy = deny`, a tunnel-only host is reachable by
+//!      `CONNECT` and spliced through *without* interception: the agent trusts
+//!      only the upstream's own certificate, not the proxy's CA, and still
+//!      connects;
+//!      (and, as a control, the same agent fails against an intercepting rule);
+//!   2. a host with no rule is still refused;
+//!   3. plain `http://` to a tunnel-only host is refused — the rule allows an
+//!      opaque tunnel, not a request the proxy would have to read;
+//!   4. the egress gate still applies to a tunnel-only host's addresses;
+//!   5. a tunnel rule's `ports` limit the tunnel like any other rule's;
+//!   6. the config refuses tunnel rules that pretend to constrain or inject, and
+//!      a host that is both tunnelled and intercepted.
+
+use std::convert::Infallible;
+use std::net::SocketAddr;
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::sync::Arc;
+
+use arc_swap::ArcSwap;
+use bytes::Bytes;
+use http_body_util::Full;
+use hyper::body::Incoming;
+use hyper::server::conn::http1;
+use hyper::service::service_fn;
+use hyper::{Request, Response};
+use hyper_util::rt::TokioIo;
+use rustls::pki_types::{CertificateDer, PrivateKeyDer, PrivatePkcs8KeyDer};
+use seekrit_proxy::ca::Ca;
+use seekrit_proxy::config::Config;
+use seekrit_proxy::egress::Egress;
+use seekrit_proxy::forward::{self, ForwardState};
+use seekrit_proxy::secrets::SecretStore;
+use seekrit_proxy::tasks::SessionResolver;
+use tokio::net::TcpListener;
+use tokio_rustls::TlsAcceptor;
+
+fn temp_ca() -> Ca {
+    static SEQ: AtomicUsize = AtomicUsize::new(0);
+    let dir = std::env::temp_dir().join(format!(
+        "seekrit-proxy-tunnel-{}-{}",
+        std::process::id(),
+        SEQ.fetch_add(1, Ordering::SeqCst)
+    ));
+    std::fs::create_dir_all(&dir).unwrap();
+    Ca::load_or_generate(
+        dir.join("ca.pem").to_str().unwrap(),
+        dir.join("ca-key.pem").to_str().unwrap(),
+    )
+    .unwrap()
+}
+
+/// A TLS upstream for `localhost` that answers `tunnelled` and counts hits.
+/// Returns its address and its self-signed certificate.
+async fn tls_upstream(hits: Arc<AtomicUsize>) -> (SocketAddr, String) {
+    let key = rcgen::KeyPair::generate().unwrap();
+    let cert = rcgen::CertificateParams::new(vec!["localhost".to_string()])
+        .unwrap()
+        .self_signed(&key)
+        .unwrap();
+    let pem = cert.pem();
+    let der: CertificateDer<'static> = cert.der().clone();
+    let key_der = PrivateKeyDer::Pkcs8(PrivatePkcs8KeyDer::from(key.serialize_der()));
+    let server = rustls::ServerConfig::builder_with_provider(Arc::new(
+        rustls::crypto::ring::default_provider(),
+    ))
+    .with_safe_default_protocol_versions()
+    .unwrap()
+    .with_no_client_auth()
+    .with_single_cert(vec![der], key_der)
+    .unwrap();
+    let acceptor = TlsAcceptor::from(Arc::new(server));
+
+    let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let addr = listener.local_addr().unwrap();
+    tokio::spawn(async move {
+        while let Ok((tcp, _)) = listener.accept().await {
+            let acceptor = acceptor.clone();
+            let hits = hits.clone();
+            tokio::spawn(async move {
+                if let Ok(tls) = acceptor.accept(tcp).await {
+                    let svc = service_fn(move |_req: Request<Incoming>| {
+                        hits.fetch_add(1, Ordering::SeqCst);
+                        async {
+                            Ok::<_, Infallible>(Response::new(Full::new(Bytes::from_static(
+                                b"tunnelled",
+                            ))))
+                        }
+                    });
+                    let _ = http1::Builder::new()
+                        .serve_connection(TokioIo::new(tls), svc)
+                        .await;
+                }
+            });
+        }
+    });
+    (addr, pem)
+}
+
+/// A forward proxy for `cfg`, wired as `main.rs` wires it.
+async fn forward_proxy(cfg: &str) -> String {
+    let config = Config::from_toml(cfg).unwrap();
+    let egress = Arc::new(Egress::from_config(&config));
+    let state = ForwardState {
+        client: seekrit_proxy::upstream_client(egress.clone()).unwrap(),
+        egress,
+        config: Arc::new(config),
+        store: Arc::new(ArcSwap::from_pointee(SecretStore::from_values([]))),
+        ca: Arc::new(temp_ca()),
+        metrics: Arc::new(seekrit_proxy::telemetry::Metrics::new()),
+        policy: None,
+        sessions: Arc::new(SessionResolver::new(None, None)),
+        ratchet: None,
+        activity: None,
+        approvals: None,
+    };
+    let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let addr = listener.local_addr().unwrap();
+    tokio::spawn(
+        async move { forward::serve(listener, state, std::future::pending::<()>()).await },
+    );
+    format!("http://{addr}")
+}
+
+/// An agent that proxies through `proxy` and trusts only `upstream_pem` — not
+/// the proxy's CA. If the proxy intercepted, the handshake would fail.
+fn agent(proxy: &str, upstream_pem: &str) -> reqwest::Client {
+    reqwest::Client::builder()
+        .proxy(reqwest::Proxy::http(proxy).unwrap())
+        .proxy(reqwest::Proxy::https(proxy).unwrap())
+        .tls_built_in_root_certs(false)
+        .add_root_certificate(reqwest::Certificate::from_pem(upstream_pem.as_bytes()).unwrap())
+        .build()
+        .unwrap()
+}
+
+/// Deny everything unlisted; the upstream lives on loopback, so open that range
+/// to the egress gate (a real deployment's hosts are public).
+const DENY: &str = "[egress]\nallow_cidr=['127.0.0.0/8']\n\
+                    [forward]\nlisten='127.0.0.1:0'\nunmatched_host_policy='deny'\n";
+
+#[tokio::test]
+async fn a_tunnel_only_host_is_spliced_through_without_interception() {
+    let hits = Arc::new(AtomicUsize::new(0));
+    let (upstream, pem) = tls_upstream(hits.clone()).await;
+    let proxy = forward_proxy(&format!(
+        "{DENY}[[forward.host]]\nmatch='localhost'\nintercept=false\n"
+    ))
+    .await;
+
+    let resp = agent(&proxy, &pem)
+        .get(format!("https://localhost:{}/x", upstream.port()))
+        .send()
+        .await
+        .expect("a tunnel-only host connects end to end with the upstream's own certificate");
+    assert_eq!(resp.status(), 200);
+    assert_eq!(resp.text().await.unwrap(), "tunnelled");
+    assert_eq!(hits.load(Ordering::SeqCst), 1);
+}
+
+/// The control for the test above: the same agent, the same upstream, but an
+/// intercepting rule. The proxy presents its own minted certificate, which this
+/// agent does not trust — so the tunnel test's success is not an accident of a
+/// lenient client.
+#[tokio::test]
+async fn the_same_agent_fails_against_an_intercepting_rule() {
+    let hits = Arc::new(AtomicUsize::new(0));
+    let (upstream, pem) = tls_upstream(hits.clone()).await;
+    let proxy = forward_proxy(&format!("{DENY}[[forward.host]]\nmatch='localhost'\n")).await;
+
+    let result = agent(&proxy, &pem)
+        .get(format!("https://localhost:{}/x", upstream.port()))
+        .send()
+        .await;
+    assert!(
+        result.is_err(),
+        "an intercepted host presents the proxy's certificate"
+    );
+    assert_eq!(hits.load(Ordering::SeqCst), 0);
+}
+
+#[tokio::test]
+async fn a_host_without_a_rule_is_still_refused() {
+    let hits = Arc::new(AtomicUsize::new(0));
+    let (upstream, pem) = tls_upstream(hits.clone()).await;
+    let proxy = forward_proxy(&format!(
+        "{DENY}[[forward.host]]\nmatch='elsewhere.test'\nintercept=false\n"
+    ))
+    .await;
+
+    let result = agent(&proxy, &pem)
+        .get(format!("https://localhost:{}/x", upstream.port()))
+        .send()
+        .await;
+    assert!(result.is_err(), "CONNECT to an unlisted host must fail");
+    assert_eq!(hits.load(Ordering::SeqCst), 0);
+}
+
+#[tokio::test]
+async fn plain_http_to_a_tunnel_only_host_is_refused() {
+    let proxy = forward_proxy(&format!(
+        "{DENY}[[forward.host]]\nmatch='localhost'\nintercept=false\n"
+    ))
+    .await;
+    let resp = agent(&proxy, &tls_upstream(Arc::default()).await.1)
+        .get("http://localhost:9/x")
+        .send()
+        .await
+        .unwrap();
+    assert_eq!(resp.status(), 403);
+    assert!(resp.text().await.unwrap().contains("only as a TLS tunnel"));
+}
+
+#[tokio::test]
+async fn the_egress_gate_still_applies_to_a_tunnel_only_host() {
+    let hits = Arc::new(AtomicUsize::new(0));
+    let (upstream, pem) = tls_upstream(hits.clone()).await;
+    // No allow_cidr: `localhost` resolves to loopback, which the gate refuses
+    // even though a rule names the host.
+    let proxy = forward_proxy(
+        "[forward]\nlisten='127.0.0.1:0'\nunmatched_host_policy='deny'\n\
+         [[forward.host]]\nmatch='localhost'\nintercept=false\n",
+    )
+    .await;
+    let result = agent(&proxy, &pem)
+        .get(format!("https://localhost:{}/x", upstream.port()))
+        .send()
+        .await;
+    assert!(
+        result.is_err(),
+        "a tunnel must not reach a loopback address"
+    );
+    assert_eq!(hits.load(Ordering::SeqCst), 0);
+}
+
+#[tokio::test]
+async fn a_tunnel_rule_follows_its_ports() {
+    let hits = Arc::new(AtomicUsize::new(0));
+    let (upstream, pem) = tls_upstream(hits.clone()).await;
+    let url = format!("https://localhost:{}/x", upstream.port());
+
+    let wrong = forward_proxy(&format!(
+        "{DENY}[[forward.host]]\nmatch='localhost'\nintercept=false\nports=[443]\n"
+    ))
+    .await;
+    assert!(agent(&wrong, &pem).get(&url).send().await.is_err());
+    assert_eq!(hits.load(Ordering::SeqCst), 0, "never spliced");
+
+    let right = forward_proxy(&format!(
+        "{DENY}[[forward.host]]\nmatch='localhost'\nintercept=false\nports=[443, {}]\n",
+        upstream.port()
+    ))
+    .await;
+    let resp = agent(&right, &pem).get(&url).send().await.unwrap();
+    assert_eq!(resp.status(), 200);
+    assert_eq!(hits.load(Ordering::SeqCst), 1);
+}
+
+#[test]
+fn the_config_parses_tunnel_rules_apart_from_intercept_rules() {
+    let config = Config::from_toml(
+        "[forward]\n\
+         [[forward.host]]\nmatch='Tunnel.Test'\nintercept=false\n\
+         [[forward.host]]\nmatch='read.test'\n\
+         [[forward.host]]\nmatch='also-read.test'\nintercept=true\n",
+    )
+    .unwrap();
+    let fwd = config.forward.unwrap();
+    assert!(fwd.tunnels("tunnel.test"), "matched case-insensitively");
+    assert!(!fwd.tunnels("read.test"));
+    let rules = fwd.rules.unwrap();
+    assert!(rules.covers_host("read.test") && rules.covers_host("also-read.test"));
+    assert!(
+        !rules.covers_host("tunnel.test"),
+        "a tunnel host must never reach the intercepting rule set"
+    );
+}
+
+#[test]
+fn the_config_refuses_tunnel_rules_that_claim_to_see_inside() {
+    for (extra, why) in [
+        ("allow=['K']", "allow"),
+        ("methods=['GET']", "methods"),
+        ("paths=['/x']", "paths"),
+    ] {
+        let err = Config::from_toml(&format!(
+            "[forward]\n[[forward.host]]\nmatch='t.test'\nintercept=false\n{extra}\n"
+        ))
+        .err()
+        .map(|e| e.to_string());
+        assert!(
+            err.as_deref()
+                .is_some_and(|e| e.contains("intercept = false")),
+            "{why}: {err:?}"
+        );
+    }
+
+    let err = Config::from_toml(
+        "[forward]\n\
+         [[forward.host]]\nmatch='both.test'\n\
+         [[forward.host]]\nmatch='both.test'\nintercept=false\n",
+    )
+    .err()
+    .map(|e| e.to_string());
+    assert!(
+        err.as_deref()
+            .is_some_and(|e| e.contains("either intercepted or tunnelled")),
+        "{err:?}"
+    );
+}
