+/// The environment variable that selects the log line format: `json` for one
+/// JSON object per line, anything else (or unset) for the human-readable text.
+pub const LOG_FORMAT_ENV: &str = "SEEKRIT_LOG_FORMAT";
+
+/// True when [`LOG_FORMAT_ENV`] asks for JSON log lines.
+pub fn json_logs() -> bool {
+    std::env::var(LOG_FORMAT_ENV).is_ok_and(|v| v.trim().eq_ignore_ascii_case("json"))
+}
+
+/// The stdout formatter: human-readable text, or (with
+/// `SEEKRIT_LOG_FORMAT=json`) one JSON object per line.
+///
+/// JSON lines put an event's fields at the top level (`flatten_event`) beside
+/// `timestamp`, `level`, and `target`, and leave out the enclosing spans: a log
+/// collector filtering on `target` and a field should not have to know which
+/// span an event happened to be emitted in.
+pub(crate) fn fmt_layer<S>() -> Box<dyn tracing_subscriber::Layer<S> + Send + Sync>
+where
+    S: tracing::Subscriber + for<'a> tracing_subscriber::registry::LookupSpan<'a>,
+{
+    if json_logs() {
+        Box::new(
+            tracing_subscriber::fmt::layer()
+                .json()
+                .flatten_event(true)
+                .with_current_span(false)
+                .with_span_list(false),
+        )
+    } else {
+        Box::new(tracing_subscriber::fmt::layer())
+    }
+}
+
