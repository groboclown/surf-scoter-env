@@ -0,0 +1,313 @@
+//! The `seekrit_access` log, as the real binary writes it with
+//! `SEEKRIT_LOG_FORMAT=json`.
+//!
+//! Proves, from the process's actual stdout:
+//!   1. every line is one JSON object with `timestamp`, `level`, and `target`,
+//!      and an event's fields at the top level;
+//!   2. each `CONNECT` decision is logged: intercept, tunnel, and deny, with the
+//!      reason;
+//!   3. each answered request is logged with its plane, method, host, port,
+//!      path, status, and the *names* of injected secrets;
+//!   4. a closed tunnel is logged with the bytes it carried;
+//!   5. no secret value and no query string reaches the log.
+#![cfg(unix)]
+
+use std::collections::BTreeMap;
+use std::io::{BufRead, BufReader, Write};
+use std::net::SocketAddr;
+use std::path::PathBuf;
+use std::process::{Child, Command, Stdio};
+use std::sync::Arc;
+use std::time::{Duration, Instant};
+
+use axum::routing::any;
+use axum::Router;
+use rustls::pki_types::{CertificateDer, PrivateKeyDer, PrivatePkcs8KeyDer};
+use serde_json::Value;
+use tokio::io::{AsyncReadExt, AsyncWriteExt};
+use tokio::net::TcpListener;
+use tokio_rustls::TlsAcceptor;
+
+const SECRET: &str = "s3cr3t-value-for-the-access-log";
+const QUERY_TOKEN: &str = "query-token-never-logged";
+
+struct TempDir(PathBuf);
+
+impl TempDir {
+    fn new() -> TempDir {
+        // Short: the inject socket must fit a Unix socket address.
+        let dir = std::env::temp_dir().join(format!("sk-al-{}", std::process::id()));
+        std::fs::create_dir_all(&dir).unwrap();
+        TempDir(dir)
+    }
+}
+
+impl Drop for TempDir {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_dir_all(&self.0);
+    }
+}
+
+/// Kills the proxy if a test assertion fails before it is collected.
+struct Proxy(Option<Child>);
+
+impl Drop for Proxy {
+    fn drop(&mut self) {
+        if let Some(child) = self.0.as_mut() {
+            let _ = child.kill();
+            let _ = child.wait();
+        }
+    }
+}
+
+async fn http_upstream() -> SocketAddr {
+    let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let addr = listener.local_addr().unwrap();
+    tokio::spawn(async move {
+        axum::serve(listener, Router::new().fallback(any(|| async { "ok" })))
+            .await
+            .unwrap();
+    });
+    addr
+}
+
+/// A TLS server that answers any request with a fixed HTTP response. Only the
+/// tunnel test talks to it, through a blind tunnel the proxy cannot read.
+async fn tls_upstream() -> SocketAddr {
+    let key = rcgen::KeyPair::generate().unwrap();
+    let cert = rcgen::CertificateParams::new(vec!["127.0.0.1".to_string()])
+        .unwrap()
+        .self_signed(&key)
+        .unwrap();
+    let der: CertificateDer<'static> = cert.der().clone();
+    let key_der = PrivateKeyDer::Pkcs8(PrivatePkcs8KeyDer::from(key.serialize_der()));
+    let server = rustls::ServerConfig::builder_with_provider(Arc::new(
+        rustls::crypto::ring::default_provider(),
+    ))
+    .with_safe_default_protocol_versions()
+    .unwrap()
+    .with_no_client_auth()
+    .with_single_cert(vec![der], key_der)
+    .unwrap();
+    let acceptor = TlsAcceptor::from(Arc::new(server));
+    let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let addr = listener.local_addr().unwrap();
+    tokio::spawn(async move {
+        while let Ok((tcp, _)) = listener.accept().await {
+            let acceptor = acceptor.clone();
+            tokio::spawn(async move {
+                if let Ok(mut tls) = acceptor.accept(tcp).await {
+                    let mut buf = [0u8; 1024];
+                    let _ = tls.read(&mut buf).await;
+                    let _ = tls
+                        .write_all(
+                            b"HTTP/1.1 200 OK\r\ncontent-length: 2\r\nconnection: close\r\n\r\nok",
+                        )
+                        .await;
+                    let _ = tls.shutdown().await;
+                }
+            });
+        }
+    });
+    addr
+}
+
+fn free_port() -> u16 {
+    std::net::TcpListener::bind("127.0.0.1:0")
+        .unwrap()
+        .local_addr()
+        .unwrap()
+        .port()
+}
+
+async fn wait_for(addr: SocketAddr, path: &std::path::Path) {
+    let deadline = Instant::now() + Duration::from_secs(10);
+    while Instant::now() < deadline {
+        if path.exists() && tokio::net::TcpStream::connect(addr).await.is_ok() {
+            return;
+        }
+        tokio::time::sleep(Duration::from_millis(50)).await;
+    }
+    panic!("the proxy did not start listening");
+}
+
+#[tokio::test]
+async fn the_access_log_records_decisions_requests_and_tunnels_as_json() {
+    let dir = TempDir::new();
+    let socket = dir.0.join("i.sock");
+    let ca_cert = dir.0.join("ca.pem");
+    let http = http_upstream().await;
+    let tls = tls_upstream().await;
+    let listen: SocketAddr = format!("127.0.0.1:{}", free_port()).parse().unwrap();
+
+    let config = dir.0.join("proxy.toml");
+    std::fs::write(
+        &config,
+        format!(
+            "[egress]\nallow_cidr=['127.0.0.0/8']\n\
+             [forward]\nlisten='{listen}'\nunmatched_host_policy='deny'\n\
+             ca_cert='{}'\nca_key='{}'\n\
+             [[forward.host]]\nmatch='localhost'\nallow=['API_KEY']\n\
+             [[forward.host]]\nmatch='127.0.0.1'\nintercept=false\n\
+             [secrets]\nsource='inject'\nsocket='{}'\n",
+            ca_cert.display(),
+            dir.0.join("ca-key.pem").display(),
+            socket.display(),
+        ),
+    )
+    .unwrap();
+
+    let bin = env!("CARGO_BIN_EXE_seekrit-proxy");
+    let mut proxy = Proxy(Some(
+        Command::new(bin)
+            .arg("--config")
+            .arg(&config)
+            .env("SEEKRIT_LOG_FORMAT", "json")
+            .env("RUST_LOG", "warn,seekrit_access=info")
+            .env_remove("SEEKRIT_TOKEN")
+            .stdout(Stdio::piped())
+            .stderr(Stdio::piped())
+            .spawn()
+            .unwrap(),
+    ));
+    wait_for(listen, &socket).await;
+
+    let mut inject = Command::new(bin)
+        .args(["inject", "--socket"])
+        .arg(&socket)
+        .stdin(Stdio::piped())
+        .stdout(Stdio::null())
+        .spawn()
+        .unwrap();
+    inject
+        .stdin
+        .take()
+        .unwrap()
+        .write_all(format!(r#"{{"values": {{"API_KEY": "{SECRET}"}}}}"#).as_bytes())
+        .unwrap();
+    assert!(inject.wait().unwrap().success());
+
+    let proxy_url = format!("http://{listen}");
+    let ca = reqwest::Certificate::from_pem(&std::fs::read(&ca_cert).unwrap()).unwrap();
+    let agent = reqwest::Client::builder()
+        .proxy(reqwest::Proxy::all(&proxy_url).unwrap())
+        .add_root_certificate(ca)
+        .build()
+        .unwrap();
+
+    // Plain HTTP to a ruled host, with a secret injected and a query token.
+    let resp = agent
+        .get(format!(
+            "http://localhost:{}/v1/items?token={QUERY_TOKEN}",
+            http.port()
+        ))
+        .header("authorization", "Bearer {{seekrit:API_KEY}}")
+        .send()
+        .await
+        .unwrap();
+    assert_eq!(resp.status(), 200);
+
+    // Intercepted HTTPS to the same host. The upstream there speaks plain HTTP,
+    // so the proxy's re-originated TLS fails and it answers 502 itself — still
+    // one intercepted request, logged.
+    let resp = agent
+        .get(format!("https://localhost:{}/v2/thing", http.port()))
+        .send()
+        .await
+        .unwrap();
+    assert_eq!(resp.status(), 502);
+
+    // A tunnel-only host, spliced through. The proxy never sees inside, so
+    // this agent accepts the upstream's self-signed certificate itself.
+    let tunnel_agent = reqwest::Client::builder()
+        .proxy(reqwest::Proxy::all(&proxy_url).unwrap())
+        .danger_accept_invalid_certs(true)
+        .build()
+        .unwrap();
+    let resp = tunnel_agent
+        .get(format!("https://127.0.0.1:{}/", tls.port()))
+        .send()
+        .await
+        .unwrap();
+    assert_eq!(resp.status(), 200);
+    assert_eq!(resp.text().await.unwrap(), "ok");
+    drop(tunnel_agent);
+
+    // A host with no rule.
+    assert!(agent.get("https://other.test/").send().await.is_err());
+
+    // Give the tunnel's close event a moment, then stop the proxy.
+    tokio::time::sleep(Duration::from_millis(300)).await;
+    let mut child = proxy.0.take().unwrap();
+    child.kill().unwrap();
+    child.wait().unwrap();
+    let mut stdout = String::new();
+    std::io::Read::read_to_string(&mut child.stdout.take().unwrap(), &mut stdout).unwrap();
+    let mut stderr = String::new();
+    std::io::Read::read_to_string(&mut child.stderr.take().unwrap(), &mut stderr).unwrap();
+
+    // 5. Nothing secret, anywhere in the process's output.
+    for (stream, text) in [("stdout", &stdout), ("stderr", &stderr)] {
+        assert!(!text.contains(SECRET), "a secret value reached {stream}");
+        assert!(
+            !text.contains(QUERY_TOKEN),
+            "a query string reached {stream}"
+        );
+    }
+
+    // 1. Every line is a JSON object with the standard fields.
+    let lines: Vec<BTreeMap<String, Value>> = BufReader::new(stdout.as_bytes())
+        .lines()
+        .map(|l| l.unwrap())
+        .filter(|l| !l.trim().is_empty())
+        .map(|l| serde_json::from_str(&l).unwrap_or_else(|e| panic!("not JSON ({e}): {l}")))
+        .collect();
+    for line in &lines {
+        for key in ["timestamp", "level", "target"] {
+            assert!(line.contains_key(key), "{key} missing from {line:?}");
+        }
+    }
+    let access: Vec<&BTreeMap<String, Value>> = lines
+        .iter()
+        .filter(|l| l["target"] == "seekrit_access")
+        .collect();
+    let find = |pred: &dyn Fn(&BTreeMap<String, Value>) -> bool| {
+        access
+            .iter()
+            .find(|l| pred(l))
+            .copied()
+            .unwrap_or_else(|| panic!("no matching access event in:\n{stdout}"))
+    };
+
+    // 2. CONNECT decisions.
+    let intercept = find(&|l| l["event"] == "connect" && l["action"] == "intercept");
+    assert_eq!(intercept["host"], "localhost");
+    assert_eq!(intercept["port"], http.port());
+    let tunnel = find(&|l| l["event"] == "connect" && l["action"] == "tunnel");
+    assert_eq!(tunnel["host"], "127.0.0.1");
+    assert_eq!(tunnel["port"], tls.port());
+    assert_eq!(tunnel["reason"], "tunnel_rule");
+    let deny = find(&|l| l["event"] == "connect" && l["action"] == "deny");
+    assert_eq!(deny["host"], "other.test");
+    assert_eq!(deny["reason"], "no_rule");
+
+    // 3. Requests, with injected names and no query string.
+    let plain = find(&|l| l["event"] == "request" && l["plane"] == "http");
+    assert_eq!(plain["method"], "GET");
+    assert_eq!(plain["host"], "localhost");
+    assert_eq!(plain["path"], "/v1/items");
+    assert_eq!(plain["status"], 200);
+    assert_eq!(plain["injected"], "API_KEY");
+    assert!(plain["duration_ms"].is_u64());
+    let mitm = find(&|l| l["event"] == "request" && l["plane"] == "intercept");
+    assert_eq!(mitm["path"], "/v2/thing");
+    assert_eq!(mitm["status"], 502);
+    assert_eq!(mitm["injected"], "");
+
+    // 4. The tunnel's close, with what it carried each way.
+    let closed = find(&|l| l["event"] == "tunnel_closed");
+    assert_eq!(closed["host"], "127.0.0.1");
+    assert!(!closed.contains_key("error"), "{closed:?}");
+    assert!(closed["bytes_up"].as_u64().unwrap() > 0, "{closed:?}");
+    assert!(closed["bytes_down"].as_u64().unwrap() > 0, "{closed:?}");
+}
