+/// The access log line for one `CONNECT` decision: `action` is `intercept`,
+/// `tunnel`, or `deny`, and `reason` says which rule or check decided.
+fn access_connect(host: &str, port: u16, action: &'static str, reason: &'static str) {
+    info!(
+        target: "seekrit_access",
+        event = "connect",
+        host,
+        port,
+        action,
+        reason,
+        "connect"
+    );
+}
+
+/// The secret names injected into a request, attached to its response so the
+/// access log can name them. Names only — never values.
+#[derive(Clone)]
+struct Injected(Vec<String>);
+
+/// The longest request path the access log records; longer ones are cut, so a
+/// workload cannot inflate the log with a megabyte of path.
+const MAX_LOGGED_PATH: usize = 2048;
+
+/// Run one request's handler and write its access log line: the method, host,
+/// port, and path (without the query string, which is where tokens and
+/// identifiers tend to sit), the status, how long until the response started,
+/// and the names of any secrets injected.
+///
+/// The path is the one the workload sent, before substitution, so it can hold a
+/// placeholder's *name* but never a value.
+async fn access_request<F>(
+    plane: &'static str,
+    method: Method,
+    host: &str,
+    port: u16,
+    path: &str,
+    handler: F,
+) -> Response<Body>
+where
+    F: std::future::Future<Output = Response<Body>>,
+{
+    let started = std::time::Instant::now();
+    let resp = handler.await;
+    let duration_ms = started.elapsed().as_millis() as u64;
+    let injected = resp
+        .extensions()
+        .get::<Injected>()
+        .map(|i| i.0.join(","))
+        .unwrap_or_default();
+    let path = match path.char_indices().nth(MAX_LOGGED_PATH) {
+        Some((cut, _)) => &path[..cut],
+        None => path,
+    };
+    info!(
+        target: "seekrit_access",
+        event = "request",
+        plane,
+        method = %method,
+        host,
+        port,
+        path,
+        status = resp.status().as_u16(),
+        duration_ms,
+        injected = %injected,
+        "request"
+    );
+    resp
+}
+
