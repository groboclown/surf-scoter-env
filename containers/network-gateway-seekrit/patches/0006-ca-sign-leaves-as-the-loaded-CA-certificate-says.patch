+/// The issuer for an existing CA: the certificate's own subject and key
+/// identifier, signing with `key`.
+///
+/// A leaf names its issuer by subject, and by key identifier in its authority
+/// key identifier extension; a client looks for a trusted certificate with both.
+/// Rebuilding the issuer from fixed parameters instead only matched a CA this
+/// proxy had generated itself: any other CA — made with openssl, say — got
+/// leaves naming an issuer that does not exist, and every intercepted
+/// connection failed verification in the workload.
+///
+/// Refuses a certificate that is not a CA, and a key that is not the
+/// certificate's: either would mint leaves that chain to nothing.
+fn issuer_from_cert(cert_pem: &str, key: KeyPair) -> Result<Issuer<'static, KeyPair>, CaError> {
+    let (_, pem) = x509_parser::pem::parse_x509_pem(cert_pem.as_bytes())
+        .map_err(|e| CaError::Cert(format!("the CA certificate is not PEM: {e}")))?;
+    let cert = pem
+        .parse_x509()
+        .map_err(|e| CaError::Cert(format!("cannot parse the CA certificate: {e}")))?;
+    if !cert.is_ca() {
+        return Err(CaError::Cert(
+            "the CA certificate is not a CA (its basic constraints do not set cA)".into(),
+        ));
+    }
+    if cert.public_key().raw != key.subject_public_key_info().as_slice() {
+        return Err(CaError::Cert(
+            "the CA key is not the key of the CA certificate".into(),
+        ));
     }
+    Issuer::from_ca_cert_der(&CertificateDer::from(pem.contents.as_slice()), key)
+        .map_err(|e| CaError::Cert(format!("cannot use the CA certificate: {e}")))
 }
 
-/// The fixed CA certificate parameters. Kept in one place so `generate` and
-/// `load` produce a byte-identical subject (leaves must chain to the same CA).
+/// The parameters of a CA this proxy generates.
 fn ca_params() -> Result<CertificateParams, CaError> {
     let mut params =
         CertificateParams::new(Vec::new()).map_err(|e| CaError::Cert(e.to_string()))?;
@@ -197,11 +238,148 @@ mod tests {
         let c2 = ca.server_config("api.example.com").unwrap();
         assert!(Arc::ptr_eq(&c1, &c2));
 
-        // A second load reads the persisted CA back and can still mint.
+        // A second load reads the persisted CA back, and its leaves still
