+
+    /// A scratch directory holding `ca.pem` and `ca-key.pem`.
+    struct CaFiles(std::path::PathBuf);
+
+    impl CaFiles {
+        fn write(name: &str, cert_pem: &str, key_pem: &str) -> CaFiles {
+            let dir = std::env::temp_dir()
+                .join(format!("seekrit-proxy-ca-{name}-{}", std::process::id()));
+            std::fs::create_dir_all(&dir).unwrap();
+            std::fs::write(dir.join("ca.pem"), cert_pem).unwrap();
+            std::fs::write(dir.join("ca-key.pem"), key_pem).unwrap();
+            CaFiles(dir)
+        }
+
+        fn load(&self) -> Result<Ca, CaError> {
+            Ca::load_or_generate(
+                self.0.join("ca.pem").to_str().unwrap(),
+                self.0.join("ca-key.pem").to_str().unwrap(),
+            )
+        }
+    }
+
+    impl Drop for CaFiles {
+        fn drop(&mut self) {
+            let _ = std::fs::remove_dir_all(&self.0);
+        }
+    }
+
+    /// A CA as another tool would make it: its own subject, and a subject key
+    /// identifier this proxy would not compute (openssl hashes differently).
+    fn operator_ca() -> (String, KeyPair) {
+        let key = KeyPair::generate().unwrap();
+        let mut params = CertificateParams::new(Vec::new()).unwrap();
+        params.is_ca = IsCa::Ca(BasicConstraints::Unconstrained);
+        params
+            .distinguished_name
+            .push(DnType::CommonName, "Example Operator CA");
+        params
+            .distinguished_name
+            .push(DnType::OrganizationName, "Example");
+        params.key_usages = vec![KeyUsagePurpose::KeyCertSign, KeyUsagePurpose::CrlSign];
+        params.key_identifier_method = rcgen::KeyIdMethod::PreSpecified(vec![0xab; 20]);
+        let cert = params.self_signed(&key).unwrap();
+        (cert.pem(), key)
+    }
+
+    /// Mint a leaf for `host` and check it the way a workload would: it must
+    /// verify against `ca_pem` as the only trusted root, and name that
+    /// certificate as its issuer by subject and by key identifier.
+    fn assert_chains(ca: &Ca, ca_pem: &str, host: &str) {
+        use rustls::client::danger::ServerCertVerifier;
+        use rustls::pki_types::{ServerName, UnixTime};
+
+        let (leaf, _) = ca.mint_leaf(host).unwrap();
+        let (_, ca_pem) = x509_parser::pem::parse_x509_pem(ca_pem.as_bytes()).unwrap();
+        let root = CertificateDer::from(ca_pem.contents.clone());
+
+        let mut roots = rustls::RootCertStore::empty();
+        roots.add(root).unwrap();
+        let verifier = rustls::client::WebPkiServerVerifier::builder_with_provider(
+            Arc::new(roots),
+            Arc::new(rustls::crypto::ring::default_provider()),
+        )
+        .build()
+        .unwrap();
+        verifier
+            .verify_server_cert(
+                &leaf,
+                &[],
+                &ServerName::try_from(host.to_string()).unwrap(),
+                &[],
+                UnixTime::now(),
+            )
+            .expect("the leaf verifies against the CA certificate");
+
+        let ca_cert = ca_pem.parse_x509().unwrap();
+        let (_, leaf) = x509_parser::parse_x509_certificate(&leaf).unwrap();
+        assert_eq!(leaf.issuer().as_raw(), ca_cert.subject().as_raw());
+        let ski = ca_cert
+            .extensions()
+            .iter()
+            .find_map(|e| match e.parsed_extension() {
+                x509_parser::extensions::ParsedExtension::SubjectKeyIdentifier(id) => Some(id.0),
+                _ => None,
+            })
+            .expect("the CA has a subject key identifier");
+        let aki = leaf
+            .extensions()
+            .iter()
+            .find_map(|e| match e.parsed_extension() {
+                x509_parser::extensions::ParsedExtension::AuthorityKeyIdentifier(a) => {
+                    a.key_identifier.as_ref().map(|k| k.0)
+                }
+                _ => None,
+            })
+            .expect("the leaf has an authority key identifier");
+        assert_eq!(aki, ski, "the leaf names the CA's own key identifier");
+    }
+
+    #[test]
+    fn a_ca_made_elsewhere_signs_as_its_certificate_says() {
+        let (cert_pem, key) = operator_ca();
+        let files = CaFiles::write("operator", &cert_pem, &key.serialize_pem());
+        let ca = files.load().unwrap();
+        assert_eq!(ca.cert_pem(), cert_pem, "the operator's file, untouched");
+        assert_chains(&ca, &cert_pem, "api.example.com");
+    }
+
+    #[test]
+    fn a_key_that_is_not_the_certificates_is_refused() {
+        let (cert_pem, _) = operator_ca();
+        let other = KeyPair::generate().unwrap();
+        let files = CaFiles::write("mismatch", &cert_pem, &other.serialize_pem());
+        let err = files.load().err().expect("a mismatched key is refused");
+        assert!(err.to_string().contains("not the key of the CA"), "{err}");
+    }
+
+    #[test]
+    fn a_certificate_that_is_not_a_ca_is_refused() {
+        let key = KeyPair::generate().unwrap();
+        let leaf = CertificateParams::new(vec!["not-a-ca.example".to_string()])
+            .unwrap()
+            .self_signed(&key)
+            .unwrap();
+        let files = CaFiles::write("not-ca", &leaf.pem(), &key.serialize_pem());
+        let err = files.load().err().expect("a non-CA certificate is refused");
+        assert!(err.to_string().contains("is not a CA"), "{err}");
+    }
+
+    #[test]
+    fn a_file_that_is_not_a_certificate_is_refused() {
+        let key = KeyPair::generate().unwrap();
+        let files = CaFiles::write("not-pem", "not a certificate", &key.serialize_pem());
+        assert!(files.load().is_err());
+    }
 }
