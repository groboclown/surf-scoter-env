diff --git a/src/inject.rs b/src/inject.rs
new file mode 100644
index 0000000..9d36da1
--- /dev/null
+++ b/src/inject.rs
@@ -0,0 +1,383 @@
+//! Delivering secrets to a running proxy, instead of at startup.
+//!
+//! With `[secrets] source = "api"` the service token comes from `SEEKRIT_TOKEN`
+//! or `--token`. In a container both are part of the container's definition:
+//! anyone who can `docker inspect` it reads the token, and a token is every
+//! secret it grants. A secret file mounted into the container is no better —
+//! `docker cp` reads it.
+//!
+//! `[secrets] source = "inject"` moves delivery after startup. The proxy starts
+//! with an empty, *pending* store (placeholders are refused with `503` until it
+//! loads) and listens on a Unix socket. The orchestrator runs
+//!
+//! ```text
+//! docker exec -i GATEWAY seekrit-proxy inject --socket /run/seekrit/inject.sock < payload.json
+//! ```
+//!
+//! — in practice writing the payload to the exec's stdin from memory — and the
+//! payload exists only in the two processes' memory and the socket buffer.
+//!
+//! Four decisions shape this module.
+//!
+//! **1. One successful load, then the socket is gone.** The first payload that
+//! loads swaps the store and closes and unlinks the socket. Anything that could
+//! reach the socket later (a second `docker exec`, say) cannot replace the
+//! secrets with values of its choosing for the rest of the run. A payload that
+//! fails to load changes nothing, so the orchestrator can correct it and retry.
+//!
+//! **2. One connection at a time.** Connections are handled in order, which is
+//! what makes "one successful load" race-free. A connection that stalls is cut
+//! off after [`READ_TIMEOUT`], so it cannot hold the socket open forever.
+//!
+//! **3. The socket admits only this proxy's own uid.** It is created `0600`; the
+//! kernel-attested peer uid is checked as well, so a root process (which file
+//! modes do not stop) is refused unless the proxy itself runs as root.
+//!
+//! **4. Values never reach a log or a reply.** Replies carry a count and the
+//! secret *names*; errors describe the payload's shape, never its contents.
+//! Payload buffers are `Zeroizing` and sized up front, so reading does not
+//! leave reallocated copies behind. JSON parsing is best effort on that front:
+//! the parser may hold short-lived copies of escaped strings.
+
+use std::collections::BTreeMap;
+use std::io::{Read, Write};
+use std::sync::Arc;
+use std::time::Duration;
+
+use arc_swap::ArcSwap;
+use serde::Deserialize;
+use zeroize::Zeroizing;
+
+use crate::secrets::SecretStore;
+
+/// The largest payload accepted, from stdin or over the socket.
+pub const MAX_PAYLOAD: usize = 1 << 20;
+/// How long the server waits for a connected client to finish sending.
+pub const READ_TIMEOUT: Duration = Duration::from_secs(10);
+/// How long the client waits for the reply. Generous: a token payload resolves
+/// and decrypts over the network before the proxy can answer.
+pub const REPLY_TIMEOUT: Duration = Duration::from_secs(120);
+/// Replies are one short line; anything longer is not this protocol.
+const MAX_REPLY: u64 = 64 * 1024;
+
+/// A parsed injection payload.
+pub enum Payload {
+    /// A service token: resolve and decrypt through the API, as `source = "api"`
+    /// would have at startup.
+    Token(Zeroizing<String>),
+    /// The values themselves, by name, used verbatim.
+    Values(Vec<(String, Zeroizing<String>)>),
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct RawPayload {
+    token: Option<String>,
+    values: Option<BTreeMap<String, String>>,
+}
+
+/// Parse a payload: a JSON object with exactly one of `token` (a string) or
+/// `values` (an object of name → string).
+///
+/// Errors describe the shape only. Serde's own messages are not passed on,
+/// because they can quote the input.
+pub fn parse_payload(bytes: &[u8]) -> Result<Payload, String> {
+    let raw: RawPayload = serde_json::from_slice(bytes).map_err(|e| {
+        format!(
+            "payload is not a JSON object with a string `token` or a `values` object of strings \
+             (line {}, column {})",
+            e.line(),
+            e.column()
+        )
+    })?;
+    match (raw.token, raw.values) {
+        (Some(token), None) => {
+            let token = Zeroizing::new(token);
+            if token.trim().is_empty() {
+                return Err("payload `token` is empty".into());
+            }
+            Ok(Payload::Token(token))
+        }
+        (None, Some(values)) => {
+            let mut out = Vec::with_capacity(values.len());
+            for (name, value) in values {
+                // Moved, not copied, into the zeroizing wrapper.
+                let value = Zeroizing::new(value);
+                if !crate::substitute::is_valid_name(&name) {
+                    return Err(format!(
+                        "payload name {name:?} is not a placeholder name (letters, digits, `_`)"
+                    ));
+                }
+                out.push((name, value));
+            }
+            Ok(Payload::Values(out))
+        }
+        (Some(_), Some(_)) => Err("payload has both `token` and `values`; send one".into()),
+        (None, None) => Err("payload has neither `token` nor `values`".into()),
+    }
+}
+
+/// Turn a payload into a loaded store.
+pub async fn load(
+    payload: Payload,
+    client: &reqwest::Client,
+    api_url: &str,
+) -> Result<SecretStore, String> {
+    match payload {
+        Payload::Token(token) => crate::secrets::load(client, api_url, &token)
+            .await
+            .map_err(|e| e.to_string()),
+        Payload::Values(values) => Ok(SecretStore::from_values(
+            values
+                .into_iter()
+                // `take` moves the String out of its wrapper without copying the
+                // bytes; the store re-wraps it.
+                .map(|(name, mut value)| (name, std::mem::take(&mut *value))),
+        )),
+    }
+}
+
+/// What one connection to the inject socket came to.
+#[derive(Debug, PartialEq, Eq)]
+pub enum Attempt {
+    /// The store was swapped; the socket should now close.
+    Loaded { names: Vec<String> },
+    /// Nothing changed; the socket stays open for another try.
+    Failed(String),
+}
+
+/// Read one payload from `stream`, load it, and swap it into `store` on success.
+/// Writes the one-line reply. Never panics on client misbehaviour.
+#[cfg(unix)]
+pub async fn handle(
+    mut stream: tokio::net::UnixStream,
+    own_uid: u32,
+    store: &ArcSwap<SecretStore>,
+    client: &reqwest::Client,
+    api_url: &str,
+) -> Attempt {
+    use tokio::io::{AsyncReadExt, AsyncWriteExt};
+
+    let attempt = match stream.peer_cred() {
+        Err(e) => Attempt::Failed(format!("could not read the caller's credentials: {e}")),
+        Ok(cred) if cred.uid() != own_uid => Attempt::Failed(format!(
+            "uid {} may not inject secrets; only this proxy's uid ({own_uid}) may",
+            cred.uid()
+        )),
+        Ok(_) => {
+            // Sized up front so `read_to_end` never reallocates (and so never
+            // leaves an un-zeroized copy of a partial payload behind).
+            let mut buf = Zeroizing::new(Vec::with_capacity(MAX_PAYLOAD + 1));
+            let read = tokio::time::timeout(
+                READ_TIMEOUT,
+                (&mut stream)
+                    .take(MAX_PAYLOAD as u64 + 1)
+                    .read_to_end(&mut buf),
+            )
+            .await;
+            match read {
+                Err(_) => Attempt::Failed(format!(
+                    "no complete payload within {}s",
+                    READ_TIMEOUT.as_secs()
+                )),
+                Ok(Err(e)) => Attempt::Failed(format!("could not read the payload: {e}")),
+                Ok(Ok(_)) if buf.len() > MAX_PAYLOAD => {
+                    Attempt::Failed(format!("payload is larger than {MAX_PAYLOAD} bytes"))
+                }
+                Ok(Ok(_)) => match parse_payload(&buf) {
+                    Err(e) => Attempt::Failed(e),
+                    Ok(payload) => match load(payload, client, api_url).await {
+                        Err(e) => Attempt::Failed(e),
+                        Ok(loaded) => {
+                            let mut names: Vec<String> =
+                                loaded.names().map(str::to_string).collect();
+                            names.sort();
+                            store.store(Arc::new(loaded));
+                            Attempt::Loaded { names }
+                        }
+                    },
+                },
+            }
+        }
+    };
+
+    let reply = match &attempt {
+        Attempt::Loaded { names } => format!("ok {}\n", names.len()),
+        Attempt::Failed(e) => format!("error {}\n", e.replace('\n', " ")),
+    };
+    // A client that hung up early still gets its outcome applied; there is
+    // nobody left to tell.
+    let _ = stream.write_all(reply.as_bytes()).await;
+    let _ = stream.shutdown().await;
+    attempt
+}
+
+/// Serve the inject socket until one load succeeds or the proxy shuts down,
+/// then remove the socket.
+#[cfg(unix)]
+pub async fn serve(
+    listener: tokio::net::UnixListener,
+    path: String,
+    store: Arc<ArcSwap<SecretStore>>,
+    client: reqwest::Client,
+    api_url: String,
+    mut shutdown: tokio::sync::watch::Receiver<bool>,
+) {
+    let own_uid = crate::peer::own_uid();
+    loop {
+        let accepted = tokio::select! {
+            accepted = listener.accept() => accepted,
+            _ = shutdown.wait_for(|flip| *flip) => break,
+        };
+        let stream = match accepted {
+            Ok((stream, _)) => stream,
+            Err(e) => {
+                tracing::warn!("inject socket accept failed: {e}");
+                continue;
+            }
+        };
+        match handle(stream, own_uid, &store, &client, &api_url).await {
+            Attempt::Loaded { names } => {
+                tracing::info!(
+                    count = names.len(),
+                    secrets = ?names,
+                    "secrets injected; the inject socket is now closed"
+                );
+                break;
+            }
+            Attempt::Failed(e) => {
+                tracing::warn!("secret injection refused: {e}");
+            }
+        }
+    }
+    drop(listener);
+    if let Err(e) = std::fs::remove_file(&path) {
+        if e.kind() != std::io::ErrorKind::NotFound {
+            tracing::warn!("could not remove the inject socket {path}: {e}");
+        }
+    }
+}
+
+/// `seekrit-proxy inject --socket PATH`: send stdin to the socket and report.
+///
+/// Exit codes: `0` loaded; `1` the proxy refused the payload; `2` it could not
+/// be sent (no socket, bad input, I/O).
+#[cfg(unix)]
+pub fn run_client<R: Read, O: Write, E: Write>(
+    socket: &str,
+    mut input: R,
+    out: &mut O,
+    err: &mut E,
+) -> i32 {
+    use std::os::unix::net::UnixStream;
+
+    let mut buf = Zeroizing::new(Vec::with_capacity(MAX_PAYLOAD + 1));
+    if let Err(e) = (&mut input)
+        .take(MAX_PAYLOAD as u64 + 1)
+        .read_to_end(&mut buf)
+    {
+        let _ = writeln!(err, "seekrit-proxy inject: could not read stdin: {e}");
+        return 2;
+    }
+    if buf.len() > MAX_PAYLOAD {
+        let _ = writeln!(
+            err,
+            "seekrit-proxy inject: payload is larger than {MAX_PAYLOAD} bytes"
+        );
+        return 2;
+    }
+
+    let mut stream = match UnixStream::connect(socket) {
+        Ok(s) => s,
+        Err(e) => {
+            let _ = writeln!(
+                err,
+                "seekrit-proxy inject: could not connect to {socket}: {e} (secrets may already \
+                 have been injected; the socket closes after one successful load)"
+            );
+            return 2;
+        }
+    };
+    let sent = stream
+        .write_all(&buf)
+        .and_then(|()| stream.shutdown(std::net::Shutdown::Write));
+    drop(buf);
+    if let Err(e) = sent {
+        let _ = writeln!(err, "seekrit-proxy inject: could not send the payload: {e}");
+        return 2;
+    }
+
+    let _ = stream.set_read_timeout(Some(REPLY_TIMEOUT));
+    let mut reply = String::new();
+    if let Err(e) = (&mut stream).take(MAX_REPLY).read_to_string(&mut reply) {
+        let _ = writeln!(err, "seekrit-proxy inject: no reply from the proxy: {e}");
+        return 2;
+    }
+    let reply = reply.trim_end();
+    if let Some(count) = reply.strip_prefix("ok ") {
+        let _ = writeln!(out, "seekrit-proxy inject: loaded {count} secret(s)");
+        0
