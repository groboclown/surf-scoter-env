+    use super::*;
+
+    fn values(p: Payload) -> Vec<(String, String)> {
+        match p {
+            Payload::Values(v) => v.into_iter().map(|(n, v)| (n, v.to_string())).collect(),
+            Payload::Token(_) => panic!("expected values"),
+        }
+    }
+
+    #[test]
+    fn parses_values() {
+        let p = parse_payload(br#"{"values": {"B": "two", "A": "one"}}"#).unwrap();
+        assert_eq!(
+            values(p),
+            vec![("A".into(), "one".into()), ("B".into(), "two".into())]
+        );
+    }
+
+    #[test]
+    fn parses_a_token() {
+        match parse_payload(br#"{"token": "skt_x"}"#).unwrap() {
+            Payload::Token(t) => assert_eq!(t.as_str(), "skt_x"),
+            Payload::Values(_) => panic!("expected a token"),
+        }
+    }
+
+    #[test]
+    fn refuses_both_neither_and_unknown_fields() {
+        assert!(parse_payload(br#"{"token": "t", "values": {}}"#).is_err());
+        assert!(parse_payload(br#"{}"#).is_err());
+        assert!(parse_payload(br#"{"tokens": "t"}"#).is_err());
+        assert!(parse_payload(br#"{"token": "  "}"#).is_err());
+    }
+
+    #[test]
+    fn refuses_a_name_that_is_not_a_placeholder_name() {
+        let e = parse_payload(br#"{"values": {"BAD-NAME": "v"}}"#)
+            .err()
+            .unwrap();
+        assert!(e.contains("BAD-NAME"));
+    }
+
+    #[test]
+    fn errors_never_quote_a_value() {
+        // A value of the wrong type: serde's own message would quote it.
+        let e = parse_payload(br#"{"values": {"A": ["sentinel-value-xyz"]}}"#)
+            .err()
+            .unwrap();
+        assert!(!e.contains("sentinel-value-xyz"), "{e}");
+        let e = parse_payload(br#"{"token": 12345678901}"#).err().unwrap();
+        assert!(!e.contains("12345678901"), "{e}");
+    }
+}
