+#[tokio::test]
+async fn a_caller_with_another_uid_is_refused() {
+    let (server, mut peer) = tokio::net::UnixStream::pair().unwrap();
+    {
+        use tokio::io::AsyncWriteExt;
+        peer.write_all(br#"{"values": {"A": "one"}}"#)
+            .await
+            .unwrap();
+        peer.shutdown().await.unwrap();
+    }
+    let store = ArcSwap::from_pointee(SecretStore::pending());
+    let other_uid = seekrit_proxy::peer::own_uid().wrapping_add(1);
+    let attempt = inject::handle(
+        server,
+        other_uid,
+        &store,
+        &seekrit_proxy::api_client().unwrap(),
+        "http://127.0.0.1:9",
+    )
+    .await;
+    assert!(
+        matches!(&attempt, Attempt::Failed(e) if e.contains("may not inject")),
+        "{attempt:?}"
+    );
+    assert!(store.load().is_pending());
+}
