+#[tokio::test]
+async fn placeholders_get_503_until_the_secrets_arrive() {
+    let hits = Arc::new(AtomicUsize::new(0));
+    let counter = hits.clone();
+    let upstream = spawn(Router::new().fallback(any(move || {
+        let counter = counter.clone();
+        async move {
+            counter.fetch_add(1, Ordering::SeqCst);
+            "upstream"
+        }
+    })))
+    .await;
+
+    let cfg = format!(
+        "listen = \"127.0.0.1:0\"\n\
+         [secrets]\nsource = \"inject\"\nsocket = \"/run/seekrit/inject.sock\"\n\
+         [[route]]\nprefix = \"/up\"\nupstream = \"http://{upstream}\"\nallow = [\"API_KEY\"]\n"
+    );
+    let config = Config::from_toml(&cfg).unwrap();
+    let store = Arc::new(ArcSwap::from_pointee(SecretStore::pending()));
+    let state = AppState {
+        client: seekrit_proxy::upstream_client(Arc::new(
+            seekrit_proxy::egress::Egress::from_config(&config),
+        ))
+        .unwrap(),
+        config: Arc::new(config),
+        store: store.clone(),
+        metrics: Arc::new(seekrit_proxy::telemetry::Metrics::new()),
+        policy: None,
+        sessions: Arc::new(SessionResolver::new(None, None)),
+        ratchet: None,
+        activity: None,
+        approvals: None,
+    };
+    let base = format!("http://{}", spawn(router(state)).await);
+    let http = reqwest::Client::new();
+
+    // A placeholder before the load: refused as temporary, never forwarded.
+    let resp = http
+        .get(format!("{base}/up/x"))
+        .header("authorization", "Bearer {{seekrit:API_KEY}}")
+        .send()
+        .await
+        .unwrap();
+    assert_eq!(resp.status(), 503);
+    assert!(resp.text().await.unwrap().contains("not loaded yet"));
+    assert_eq!(hits.load(Ordering::SeqCst), 0);
+
+    // A placeholder that is not allowed is still a plain denial, not a 503.
+    let resp = http
+        .get(format!("{base}/up/x"))
+        .header("authorization", "Bearer {{seekrit:OTHER}}")
+        .send()
+        .await
+        .unwrap();
+    assert_eq!(resp.status(), 403);
+
+    // No placeholder: passes straight through, even while pending.
+    let resp = http.get(format!("{base}/up/x")).send().await.unwrap();
+    assert_eq!(resp.status(), 200);
+    assert_eq!(hits.load(Ordering::SeqCst), 1);
+
+    // Once loaded, the same request is filled in and forwarded.
+    store.store(Arc::new(SecretStore::from_values([(
+        "API_KEY".to_string(),
+        "s3cr3t-value".to_string(),
+    )])));
+    let resp = http
+        .get(format!("{base}/up/x"))
+        .header("authorization", "Bearer {{seekrit:API_KEY}}")
+        .send()
+        .await
+        .unwrap();
+    assert_eq!(resp.status(), 200);
+    assert_eq!(hits.load(Ordering::SeqCst), 2);
+}
