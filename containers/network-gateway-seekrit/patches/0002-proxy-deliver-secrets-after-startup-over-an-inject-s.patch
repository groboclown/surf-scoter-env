+#[test]
+fn the_config_refuses_what_inject_mode_cannot_serve() {
+    let inject = "[secrets]\nsource = \"inject\"\nsocket = \"/run/s/inject.sock\"\n";
+    let cases = [
+        // Needs the token at startup, or for the life of the process.
+        (
+            format!("{inject}refresh_interval = \"30s\"\n"),
+            "refresh_interval",
+        ),
+        (
+            format!("{inject}[cache]\nenabled = true\n"),
+            "[cache]",
+        ),
+        (format!("{inject}[tasks]\n"), "[tasks]"),
+        (format!("{inject}[activity]\n"), "[activity]"),
+        (
+            format!(
+                "{inject}[policy]\nsource = \"server\"\nagent = \"a\"\nagents = [\"a\"]\nsigners = [\"x\"]\n"
+            ),
+            "[policy]",
+        ),
+        // The socket itself.
+        (
+            "[secrets]\nsource = \"inject\"\n".to_string(),
+            "needs socket",
+        ),
+        (
+            "[secrets]\nsource = \"inject\"\nsocket = \"run/inject.sock\"\n".to_string(),
+            "absolute",
+        ),
+        (
+            format!(
+                "[secrets]\nsource = \"inject\"\nsocket = \"/{}/inject.sock\"\n",
+                "d".repeat(100)
+            ),
+            "must be shorter than",
+        ),
+        (
+            "[secrets]\nsocket = \"/run/inject.sock\"\n".to_string(),
+            "only used with",
+        ),
+        (
+            "[secrets]\nsource = \"file\"\n".to_string(),
+            "\"api\" or \"inject\"",
+        ),
+    ];
+    for (text, expect) in cases {
+        let text = format!("{ROUTE}{text}");
+        let err = Config::from_toml(&text).err().map(|e| e.to_string());
+        assert!(
+            err.as_deref().is_some_and(|e| e.contains(expect)),
+            "expected an error containing {expect:?} for:\n{text}\ngot {err:?}"
+        );
+    }
+}
