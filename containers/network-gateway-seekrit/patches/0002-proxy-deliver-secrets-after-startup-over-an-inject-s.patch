+#[tokio::test]
+async fn a_token_that_does_not_resolve_is_refused_and_the_store_stays_pending() {
+    let dir = TempDir::new("token");
+    let (path, store, task, tx) = start(&dir).await;
+
+    let (code, _, err) = client(&path, r#"{"token": "skt_not_a_real_token"}"#).await;
+    assert_eq!(code, 1, "{err}");
+    assert!(
+        !err.contains("skt_not_a_real_token"),
+        "the reply must not quote the token: {err}"
+    );
+    assert!(store.load().is_pending());
+
+    // Still waiting; shutting the proxy down removes the socket.
+    tx.send(true).unwrap();
+    task.await.unwrap();
+    assert!(!std::path::Path::new(&path).exists());
+}
