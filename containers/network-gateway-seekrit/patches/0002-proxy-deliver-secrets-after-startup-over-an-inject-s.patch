+#[tokio::test]
+async fn a_failed_load_changes_nothing_and_can_be_retried() {
+    let dir = TempDir::new("retry");
+    let (path, store, task, _tx) = start(&dir).await;
+
+    for bad in [
+        "not json",
+        r#"{"values": {"BAD-NAME": "v"}}"#,
+        r#"{"token": "t", "values": {}}"#,
+    ] {
+        let (code, _, err) = client(&path, bad).await;
+        assert_eq!(code, 1, "{bad}: {err}");
+        assert!(err.contains("refused"), "{err}");
+        assert!(store.load().is_pending(), "{bad} must not load");
+        assert!(std::path::Path::new(&path).exists());
+    }
+
+    let (code, _, err) = client(&path, r#"{"values": {"A": "one"}}"#).await;
+    assert_eq!(code, 0, "{err}");
+    task.await.unwrap();
+    assert_eq!(store.load().get("A"), Some("one"));
+}
