+/// The smallest config with something to proxy; every case below adds to it.
+const ROUTE: &str = "[[route]]\nprefix = \"/up\"\nupstream = \"https://api.test\"\n";
+
+#[test]
+fn the_config_parses_inject_mode() {
+    let config = Config::from_toml(&format!(
+        "{ROUTE}[secrets]\nsource = \"inject\"\nsocket = \"/run/s/inject.sock\"\n"
+    ))
+    .unwrap();
+    assert_eq!(
+        config.secrets.source,
+        SecretSource::Inject {
+            socket: "/run/s/inject.sock".into()
+        }
+    );
+    assert!(config.secrets.is_inject());
+    assert_eq!(
+        Config::from_toml(ROUTE).unwrap().secrets.source,
+        SecretSource::Api
+    );
+}
