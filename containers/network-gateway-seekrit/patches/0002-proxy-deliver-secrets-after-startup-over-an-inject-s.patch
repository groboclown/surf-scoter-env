+        let (name, inline) = match arg.split_once('=') {
+            Some((n, v)) if n.starts_with("--") => (n.to_string(), Some(v.to_string())),
+            _ => (arg, None),
+        };
+        match name.as_str() {
+            "-h" | "--help" => return Ok(Parsed::Help),
+            "--socket" => socket = Some(take(&name, inline, &mut it)?),
+            other => return Err(format!("unknown inject option: {other}")),
+        }
+    }
