@@ -0,0 +1,357 @@
+//! `[secrets] source = "inject"`: secrets delivered to a running proxy over a
+//! Unix socket, once.
+//!
+//! Proves:
+//!   1. a values payload loads, and the socket is gone afterwards (one-shot);
+//!   2. a payload that fails to load changes nothing and can be retried;
+//!   3. a caller with another uid is refused;
+//!   4. before the load, a placeholder is refused with 503 and never forwarded,
+//!      while a request without one passes;
+//!   5. the config refuses the combinations that would need a token at startup.
+#![cfg(unix)]
+
+use std::net::SocketAddr;
+use std::path::PathBuf;
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::sync::Arc;
+
+use arc_swap::ArcSwap;
+use axum::routing::any;
+use axum::Router;
+use seekrit_proxy::config::{Config, SecretSource};
+use seekrit_proxy::inject::{self, Attempt};
+use seekrit_proxy::proxy::{router, AppState};
+use seekrit_proxy::secrets::SecretStore;
+use seekrit_proxy::tasks::SessionResolver;
+use tokio::net::{TcpListener, UnixListener};
+
+/// A unique, self-removing directory for one test's socket.
+struct TempDir(PathBuf);
+
+impl TempDir {
+    fn new(label: &str) -> TempDir {
+        static N: AtomicUsize = AtomicUsize::new(0);
+        let dir = std::env::temp_dir().join(format!(
+            "seekrit-inject-{label}-{}-{}",
+            std::process::id(),
+            N.fetch_add(1, Ordering::SeqCst)
+        ));
+        std::fs::create_dir_all(&dir).unwrap();
+        TempDir(dir)
+    }
+
+    fn socket(&self) -> String {
+        self.0.join("inject.sock").to_string_lossy().into_owned()
+    }
+}
+
+impl Drop for TempDir {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_dir_all(&self.0);
+    }
+}
+
+/// Start the inject server on a fresh socket. Returns the socket path, the
+/// store it fills, the server task, and the shutdown sender (kept alive so the
+/// server is not told to stop).
+async fn start(
+    dir: &TempDir,
+) -> (
+    String,
+    Arc<ArcSwap<SecretStore>>,
+    tokio::task::JoinHandle<()>,
+    tokio::sync::watch::Sender<bool>,
+) {
+    let path = dir.socket();
+    let listener = UnixListener::bind(&path).unwrap();
+    let store = Arc::new(ArcSwap::from_pointee(SecretStore::pending()));
+    let (tx, rx) = tokio::sync::watch::channel(false);
+    let task = tokio::spawn(inject::serve(
+        listener,
+        path.clone(),
+        store.clone(),
+        seekrit_proxy::api_client().unwrap(),
+        // Unroutable: only the token test reaches it, and it must fail.
+        "http://127.0.0.1:9".to_string(),
+        rx,
+    ));
+    (path, store, task, tx)
+}
+
+/// Run the blocking `inject` client the way the subcommand does.
+async fn client(socket: &str, payload: &str) -> (i32, String, String) {
+    let socket = socket.to_string();
+    let payload = payload.as_bytes().to_vec();
+    tokio::task::spawn_blocking(move || {
+        let mut out = Vec::new();
+        let mut err = Vec::new();
+        let code = inject::run_client(&socket, payload.as_slice(), &mut out, &mut err);
+        (
+            code,
+            String::from_utf8(out).unwrap(),
+            String::from_utf8(err).unwrap(),
+        )
+    })
+    .await
+    .unwrap()
+}
