+#[tokio::test]
+async fn values_load_once_and_the_socket_closes() {
+    let dir = TempDir::new("once");
+    let (path, store, task, _tx) = start(&dir).await;
+
+    let (code, out, err) = client(&path, r#"{"values": {"API_KEY": "s3cr3t-value"}}"#).await;
+    assert_eq!(code, 0, "stderr: {err}");
+    assert!(out.contains("loaded 1"), "{out}");
+    assert!(
+        !out.contains("s3cr3t-value") && !err.contains("s3cr3t-value"),
+        "the client must never echo a value"
+    );
+
+    let loaded = store.load();
+    assert!(!loaded.is_pending());
+    assert_eq!(loaded.get("API_KEY"), Some("s3cr3t-value"));
+
+    // The server stops and removes its socket after one successful load.
+    task.await.unwrap();
+    assert!(!std::path::Path::new(&path).exists());
+
+    // So a second delivery cannot reach it, let alone replace the values.
+    let (code, _, err) = client(&path, r#"{"values": {"API_KEY": "attacker"}}"#).await;
+    assert_eq!(code, 2, "{err}");
+    assert_eq!(store.load().get("API_KEY"), Some("s3cr3t-value"));
+}
