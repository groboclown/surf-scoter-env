# Outbound firewall for the gateway's network namespace (loaded by
# entrypoint.sh).  Squid shares this namespace, so these rules govern what the
# proxy may reach on behalf of the isolated network.  Rules live in their own
# `inet` table (IPv4 + IPv6) so Docker's own tables and chains are untouched.
table inet egress {
  # Destinations that must never be reached: private, loopback, link-local,
  # multicast, and other special-purpose IPv4 ranges.  Blocking these keeps the
  # proxy from being used to reach the host, Docker networks, the LAN, or cloud
  # metadata services; only the public internet remains.
  set blocked_v4 {
    type ipv4_addr
    # Allow CIDR ranges rather than only single addresses.
    flags interval
    elements = {
      0.0.0.0/8,        # "This network" (RFC 1122)
      10.0.0.0/8,       # Private (RFC 1918)
      100.64.0.0/10,    # Carrier-grade NAT shared space (RFC 6598)
      127.0.0.0/8,      # Loopback
      169.254.0.0/16,   # Link-local, including cloud metadata (169.254.169.254)
      172.16.0.0/12,    # Private (RFC 1918); Docker's default bridge networks
      192.0.0.0/24,     # IETF protocol assignments (RFC 6890)
      192.0.2.0/24,     # Documentation TEST-NET-1 (RFC 5737)
      192.168.0.0/16,   # Private (RFC 1918)
      198.18.0.0/15,    # Benchmarking (RFC 2544)
      198.51.100.0/24,  # Documentation TEST-NET-2 (RFC 5737)
      203.0.113.0/24,   # Documentation TEST-NET-3 (RFC 5737)
      224.0.0.0/4,      # Multicast
      240.0.0.0/4       # Reserved, including broadcast 255.255.255.255
    }
  }

  # Traffic originating in this namespace (i.e. Squid's upstream connections).
  # Anything not explicitly accepted is dropped.
  chain output {
    type filter hook output priority 0; policy drop;
    # Local traffic within the namespace (e.g. the 127.0.0.11 resolver path).
    oifname "lo" accept
    # Replies and related packets for connections already allowed.
    ct state established,related accept
    # No IPv6 egress; the blocklist above only covers IPv4.
    meta nfproto ipv6 drop
    # The container's resolvers (Docker's embedded 127.0.0.11, or Podman's
    # per-network DNS); restrict to DNS only.  entrypoint.sh defines
    # `dns_servers` from /etc/resolv.conf.
    ip daddr $dns_servers udp dport 53 accept
    ip daddr $dns_servers tcp dport 53 accept
    # Never connect to private or special-purpose addresses.
    ip daddr @blocked_v4 drop
    # Everything else allowed out is HTTPS to public addresses.
    tcp dport 443 accept
    # Count, then drop, everything else (visible via `nft list table inet egress`).
    counter drop
  }

  # Traffic addressed to this namespace.  Anything not accepted is dropped.
  chain input {
    type filter hook input priority 0; policy drop;
    # Local traffic within the namespace.
    iifname "lo" accept
    # Replies to our own outbound connections (e.g. DNS answers, HTTPS responses).
    ct state established,related accept
    # Proxy connections only from the isolated network.  entrypoint.sh defines
    # `isolated_if`, since Docker assigns the network's subnet and interface
    # per environment.
    iifname $isolated_if tcp dport 3128 accept
    # Count, then drop, everything else.
    counter drop
  }

  # Packets routed through this namespace.  Nothing is forwarded.  The isolated
  # network reaches the outside only through the proxy, never by routing.
  chain forward {
    type filter hook forward priority 0; policy drop;
  }
}
