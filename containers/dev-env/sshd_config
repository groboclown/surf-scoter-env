# entrypoint.sh fills in the SSHD listening port when the container starts.
Port ${SCOTER_SSHD_PORT}
ListenAddress 127.0.0.1

HostKey /run/scoter-sshd/ssh_host_ed25519_key
PidFile none

PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no

AuthorizedKeysFile /run/scoter-sshd/authorized_keys

UsePAM no
PermitRootLogin no
AllowUsers ubuntu

# SSH sessions start with a fresh environment rather than the container's, so
# the proxy settings from docker-compose.yaml have to be set here too.
# The PATH too, with the host commands' links to the bridge client first.
SetEnv HTTP_PROXY=http://gateway:3128 HTTPS_PROXY=http://gateway:3128 http_proxy=http://gateway:3128 https_proxy=http://gateway:3128 PATH=/usr/local/scoter-bridge:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

Subsystem sftp internal-sftp

AllowAgentForwarding no
X11Forwarding no
PermitTunnel no
AllowStreamLocalForwarding no
PermitListen none

# JetBrains Gateway may require TCP forwarding.
AllowTcpForwarding yes
GatewayPorts no
# VS Code will need 'remote.autoForwardPorts: false'

LogLevel VERBOSE
